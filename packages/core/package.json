{
  "name": "mimimo",
  "version": "0.1.0",
  "type": "module",
  "description": "Tiny website companions with a framework-independent TypeScript API.",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "tsdown": "0.23.1"
  },
  "license": "MIT",
  "author": "Flowscape Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flowscape-UI/mimimo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Flowscape-UI/mimimo#readme",
  "bugs": {
    "url": "https://github.com/Flowscape-UI/mimimo/issues"
  },
  "keywords": [
    "mimimo",
    "companion",
    "mascot",
    "pet",
    "animation",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
